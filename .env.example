# Generate each token/password independently. Never commit the populated .env.
POSTGRES_DB=ripweaver_catalogue
POSTGRES_USER=ripweaver
POSTGRES_PASSWORD=replace-with-a-long-random-password
CATALOGUE_DATABASE_URL=postgresql+psycopg://ripweaver:replace-with-a-long-random-password@postgres:5432/ripweaver_catalogue
CATALOGUE_ADMIN_TOKEN=replace-with-a-different-long-random-admin-token
CATALOGUE_ALLOWED_HOSTS=api.ripweaver.com,localhost,127.0.0.1
CATALOGUE_MONTHLY_AUTOMATIC_LOOKUPS=10
CATALOGUE_SUPPORT_MINIMUM_CENTS=1000
CATALOGUE_SUPPORT_RATE_MIN_CENTS=1
CATALOGUE_SUPPORT_RATE_MAX_CENTS=100
CATALOGUE_SUPPORT_DEFAULT_RATE_CENTS=10
CATALOGUE_SUPPORT_TERMS_VERSION=2026-08-10
CATALOGUE_SUPPORT_PAYMENTS_ENABLED=false
# Add these only after the Stripe account and webhook are configured.
# CATALOGUE_STRIPE_SECRET_KEY=sk_live_replace_me
# CATALOGUE_STRIPE_WEBHOOK_SECRET=whsec_replace_me
CATALOGUE_STRIPE_SUCCESS_URL=https://ripweaver.com/support/success?session_id={CHECKOUT_SESSION_ID}
CATALOGUE_STRIPE_CANCEL_URL=https://ripweaver.com/support/cancelled
CLOUDFLARE_TUNNEL_TOKEN=replace-after-the-dedicated-tunnel-is-created
